{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartRecruitmentDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "THIS_IS_A_LONG_SECRET_KEY_CHANGE_IT_123456789",
